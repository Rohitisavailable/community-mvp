# Local development defaults. Never commit a real .env file.
APP_ENV=development
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_SECRET_KEY=replace-with-a-random-secret
AI_ENABLED=true
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
HERMES_DEFAULT_API_KEY=
HERMES_DEFAULT_PORT=8642
HERMES_COMMUNITY_PROJECT_B_API_KEY=
HERMES_COMMUNITY_PROJECT_B_PORT=8643
COMMUNITY_BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL_NAME=gpt-4o-mini
WEB_SEARCH_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_USER_IDS=
COMMUNITY_PORT=8787

# For hosted deployment, use a Supabase Postgres session-pooler URL copied from
# Supabase Connect. Keep it private as a Render environment variable.
# DATABASE_URL=
